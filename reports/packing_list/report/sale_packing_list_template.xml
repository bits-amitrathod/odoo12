<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Custom Lay out for Packing List  Report -->
    <template id="custom_address_layout">
        <t t-set="colclass" t-value="('col-sm-5' if report_type == 'html' else 'col-5') + ' ms-auto'"/>
        <t t-if="address">
            <div class="address row">
                <t t-if="information_block">
                    <t t-set="colclass" t-value="'col-5 offset-1'"/>
                    <div name="information_block" class="col-6">
                        <t t-out="information_block"/>
                    </div>
                </t>
                <div name="address" t-att-class="colclass">
                    <t t-esc="address"/>
                </div>
            </div>
        </t>
    </template>

    <template id="custom_external_layout_standard">
        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
            <div class="row">
                <div class="col-3 mb4">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 45px;" alt="Logo"/>
                </div>
                <div class="col-9 text-end" style="margin-top:22px;" t-field="company.report_header" name="moto"/>
            </div>
            <div t-if="company.logo or company.report_header" class="row zero_min_height">
                <div class="col-12">
                    <div style="border-bottom: 1px solid black;"/>
                </div>
            </div>
            <div class="row">
                <div class="col-6" name="company_address">
                    <ul class="list-unstyled">
                        <li t-if="company.is_company_details_empty">
                            <t t-esc="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/></li>
                        <li t-else="">
                            <t class="row" t-foreach="packing_list_result" t-as="packing_list">
                                <t t-if="'PO' in packing_list.origin">
                                    <div style="font-size:16px!important;">
                                        Surgical Product Solutions<br/>
                                        3046 Penn Ave<br/>
                                        Pittsburgh, PA 15201<br/>
                                        United States
                                    </div>
                                </t>
                                <t t-else="">
                                    <t t-esc="company.company_details"/>
                                </t>
                            </t>
                        </li>
                        <li t-if="forced_vat">
                            <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                            <span t-esc="forced_vat"/>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout {{  'o_report_layout_background' if company.layout_background in ['Geometric', 'Custom']  else  '' }}" t-attf-style="background-image: url({{ 'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else '/base/static/img/bg_background_template.jpg' if company.layout_background == 'Geometric' else ''}});" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <div class="pt-5">
                <!-- This div ensures that the address is not cropped by the header. -->
                <t t-call="packing_list.custom_address_layout"/>
            </div>
            <t t-out="0"/>
        </div>
        <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
            <div class="text-center" style="border-top: 1px solid black;">
                <ul class="list-inline mb4">
                    <div t-field="company.report_footer"/>
                </ul>

                <div t-if="report_type == 'pdf'" class="text-muted">
                    Page: <span class="page"/> / <span class="topage"/>
                </div>
                <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted">
                    <span t-field="o.name"/>
                </div>
            </div>
        </div>
    </template>

    <template id="custom_external_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <!-- Multicompany -->
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

<!--        <t t-if="company.external_report_layout_id" t-call="{{company.external_report_layout_id.sudo().key}}"><t t-out="0"/></t>-->
        <t t-call="packing_list.custom_external_layout_standard"><t t-out="0"/></t>

    </template>

    <template id="sale_packing_list_template">
        <t t-call="web.html_container">
             <t t-call="packing_list.custom_external_layout">
                <page>
                    <style>
                        .page-break {
                            page-break-after: always !important;
                        }
                        table {
                            font-size: 14px !important;
                        }

                    </style>
                    <div class="oe_structure"/>
                    <div>
                        <center>
                            <b>
                                <h2>Surgical Product Solutions</h2>
                                <h4>Packing List</h4>
                            </b>
                        </center>
                    </div>
                    <br/>
                    <t class="row" t-foreach="packing_list_result" t-as="packing_list">
                        <t t-set="i" t-value="0"/>
                        <t t-set='trackin_info' t-value="False"/>
                        <t t-if="packing_list.carrier_tracking_ref">
                            <t t-if="',' in packing_list.carrier_tracking_ref">
                                <t t-set='trackin_info' t-value="packing_list.carrier_tracking_ref.split(',')"/>
                            </t>
                        </t>

                        <table class="table table-condensed table-bordered">
                            <thead>
                            </thead>
                            <tbody class="invoice_tbody">
                                <tr style="border: 1px solid #ddd;">
                                    <th>
                                        Ship To:
                                        <div class="col-md-12"
                                             style="margin-top:10px;border: 1px solid #ddd;width:100%">
                                            <p style="font-weight: lighter">
                                                <span t-esc="packing_list.partner_id.display_name"></span>
                                                <br/>
                                                <span t-esc="packing_list.sale_id.partner_shipping_id.street"></span>
                                                <br/>
                                                <t t-if="packing_list.sale_id.partner_shipping_id.street2">
                                                    <span t-esc="packing_list.sale_id.partner_shipping_id.street2"></span>
                                                    <br/>
                                                </t>
                                                <span t-esc="packing_list.sale_id.partner_shipping_id.city"></span>
                                                <span t-esc="packing_list.sale_id.partner_shipping_id.state_id.name"></span>
                                                <span t-esc="packing_list.sale_id.partner_shipping_id.zip"></span>
                                                <br/>
                                                <span t-esc="packing_list.sale_id.partner_shipping_id.country_id.name"></span>
                                                <br/>
                                            </p>
                                            <t t-if="packing_list.sale_id.client_order_ref">
                                                <p style="margin-top:10px;font-weight: lighter">
                                                    PO Number:
                                                    <span t-esc="packing_list.sale_id.client_order_ref"></span>
                                                </p>
                                            </t>
                                        </div>
                                    </th>
                                    <th>
                                        Bill To:
                                        <div class="col-md-12"
                                             style="margin-top:10px;border: 1px solid #ddd;width:100%">
                                            <p style="font-weight: lighter">
                                                <span t-esc="packing_list.sale_id.partner_invoice_id.display_name"></span>
                                                <br/>
                                                <span t-esc="packing_list.sale_id.partner_invoice_id.street"></span>
                                                <br/>
                                                <t t-if="packing_list.sale_id.partner_invoice_id.street2">
                                                    <span t-esc="packing_list.sale_id.partner_invoice_id.street2"></span>
                                                    <br/>
                                                </t>
                                                <span t-esc="packing_list.sale_id.partner_invoice_id.city"></span>
                                                <span t-esc="packing_list.sale_id.partner_invoice_id.state_id.name"></span>
                                                <span t-esc="packing_list.sale_id.partner_invoice_id.zip"></span>
                                                <br/>
                                                <span t-esc="packing_list.sale_id.partner_invoice_id.country_id.name"></span>
                                                <br/>
                                            </p>
                                        </div>
                                    </th>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        <table class="table table-condensed table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>
                                                        Package Count
                                                    </th>
                                                   <!-- <th>
                                                        Req. Ship Date
                                                    </th>-->
                                                    <th>
                                                        Date Shipped
                                                    </th>
                                                    <th>
                                                        Shipping Terms
                                                    </th>
                                                    <th>
                                                        Ship Via
                                                    </th>
                                                    <th>
                                                        Order Num
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody class="invoice_tbody">
                                                <tr>
                                                    <td>
                                                        <p style="font-weight: 400">
                                                            <span t-esc="len(packing_list.package_ids)"></span>
                                                        </p>
                                                    </td>
                                                    <td>
                                                        <p style="font-weight: 400">
                                                            <span t-esc="packing_list.date_done" t-options='{"widget": "datetime"}'></span>
                                                        </p>
                                                    </td>
                                                    <td>
                                                        <p style="font-weight: 400">
                                                            <span t-esc="packing_list.shipping_terms"></span>
                                                        </p>
                                                    </td>
                                                    <td>
                                                        <p style="font-weight: 400">
                                                            <span t-esc="packing_list.delivery_method_name"></span>
                                                        </p>
                                                    </td>
                                                    <td>
                                                        <p style="font-weight: 400">
                                                            <span t-esc="packing_list.origin"></span>
                                                        </p>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        <div class="col-md-12" style="margin-top:10px;width:50%">
                                            <p style="height:10px;font-size: larger;font-weight: bold;">
                                                Package Information:
                                            </p>
                                            <p>
                                                <hr style="margin:0px;padding:0px"></hr>
                                                <t t-if="packing_list.package_ids">
                                                    <t t-foreach="packing_list.package_ids" t-as="packing">
                                                        <br/>
                                                        <span t-esc="packing.name"></span>
                                                        (#
                                                        <t t-if="trackin_info">
                                                            <span t-esc="trackin_info[packing_index]"></span>
                                                        </t>
                                                        )
                                                    </t>
                                                </t>
                                                <hr style="margin:0px;padding:0px"></hr>
                                            </p>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-condensed table-bordered">
                            <thead>
                                <tr>
                                    <th>
                                        #Line
                                    </th>
                                    <th style="width:60%;">
                                        Item/Description
                                    </th>
                                    <th>
                                        Qty Ordered
                                    </th>
                                    <th>
                                        Qty Shipped
                                    </th>
                                    <th>
                                        Qty Remaining
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <t t-foreach="packing_list.move_ids_without_package.sorted(key=lambda i: i.product_id.product_brand_id.name)" t-as="move_line">
                                    <t t-set="rowSpan" t-value="len(move_line.move_line_ids)+1"/>
                                    <tr>
                                        <td t-att-rowspan="rowSpan">
                                            <span t-esc="move_line_index + 1"/>
                                        </td>
                                        <td>
                                            <span style="font-weight: 400">
                                                Code#
                                                <span t-esc="move_line.product_tmpl_id.sku_code"/>
                                                -
                                                <span t-esc="move_line.product_tmpl_id.name"/>
                                            </span>
                                        </td>
                                        <td t-att-rowspan="rowSpan">
                                            <span style="font-weight: 400">
                                                <span t-esc="round(move_line.product_uom_qty)"/>
                                                <span t-esc="move_line.product_uom.name"/>
                                            </span>
                                        </td>
                                        <td t-att-rowspan="rowSpan">
                                            <span style="font-weight: 400">
                                                <span t-esc="round(move_line.quantity_done)"/>
                                                <span t-esc="move_line.product_uom.name"/>
                                            </span>
                                        </td>
                                        <td t-att-rowspan="rowSpan">
                                            <span style="font-weight: 400">
                                                <span t-esc="round(move_line.product_uom_qty - move_line.quantity_done)"/>
                                                <span t-esc="move_line.product_uom.name"/>
                                            </span>
                                        </td>
                                    </tr>
                                    <tr style="font-weight: 400" t-foreach="move_line.move_line_ids" t-as="move_line_id">
                                        <td>
                                            <span t-esc="move_line_id.qty_done"/>
                                            <span t-esc="move_line.product_uom.name"/>
                                            Lot#:
                                            <span t-esc="move_line_id.lot_id.name"/>
                                            Exp Date:
                                            <span t-esc="move_line_id.lot_id.use_date" t-options='{"widget": "datetime"}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="page-break"/>
                    </t>
                </page>
            </t>
        </t>
    </template>
</odoo>
