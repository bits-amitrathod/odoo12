
<odoo><data noupdate="1">
    <record id="action_update_expected_date" forcecreate="True" model="ir.cron">
            <field name="name">Update Expected Date for POs</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="model_purchase_order"/>
            <field name="state">code</field>
            <field name="code">model._update_expected_date(limit=1000)</field>
            <field name="numbercall">-1</field>
            <field name="priority">0</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="False"/>
    </record>

    <record id="action_update_tracking_flag_for_pOs" forcecreate="True" model="ir.cron">
        <field name="name">Update Tracking Flag for POs</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="model_id" ref="model_purchase_order"/>
        <field name="state">code</field>
        <field name="code">model._update_tracking_flag_for_pOs()</field>
        <field name="numbercall">-1</field>
        <field name="priority">0</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="False"/>
    </record>

 </data>
</odoo>
